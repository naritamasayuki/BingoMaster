    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the local network to sync bingo numbers in real time with nearby hosts and players."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くの司会者および参加者とビンゴの出目をリアルタイム同期するためにローカルネットワークを使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用本地网络与附近的主持人和参与者实时同步宾果号码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用區域網路與附近的主持人和參與者即時同步賓果號碼。"
          }
        }
      }
    },
    "NSUserTrackingUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to deliver more relevant ads and keep this app free to use."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お客様に関連性の高い広告を表示し、アプリを無料で提供し続けるためにトラッキング許可を使用しています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于向您展示更相关的广告，以支持我们持续免费提供本应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於向您顯示更相關的廣告，以支持我們持續免費提供本應用程式。"
          }
        }
      }

      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the local network to sync bingo numbers in real time with nearby hosts and players."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くの司会者および参加者とビンゴの出目をリアルタイム同期するためにローカルネットワークを使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用本地网络与附近的主持人和参与者实时同步宾果号码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用區域網路與附近的主持人和參與者即時同步賓果號碼。"
          }
        }

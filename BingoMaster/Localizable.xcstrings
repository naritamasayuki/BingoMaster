    "あなた専用のビンゴカードを発行し、司会者の出目とリアルタイム連動します。手動タップ・自動穴あけの両方に対応！": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた専用のビンゴカードを発行し、司会者の出目とリアルタイム連動します。手動タップ・自動穴あけの両方に対応！"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get your own bingo card synced in real time with the host. Supports both manual tapping and auto-daubing!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成你的专属宾果卡，与主持人的开奖号码实时同步。支持手动点击与自动标记！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "產生你的專屬賓果卡，與主持人的開獎號碼即時同步。支援手動點擊與自動標記！"
          }
        }
      }
    },
    "ご利用時のポイント": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご利用時のポイント"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips for Use"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用提示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用提示"
          }
        }
      }
    },
    "・Wi-Fi と Bluetooth をオンにしておくと、面倒なペアリング操作なしで近くの司会者と自動接続されます。\n・ゲーム途中の参加やアプリ再起動でも、これまでの出目とカードの状態は自動的に復元されます。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "・Wi-Fi と Bluetooth をオンにしておくと、面倒なペアリング操作なしで近くの司会者と自動接続されます。\n・ゲーム途中の参加やアプリ再起動でも、これまでの出目とカードの状態は自動的に復元されます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "• Keep Wi-Fi and Bluetooth turned on to connect automatically with a nearby host without pairing.\n• Even if you join mid-game or restart the app, drawn numbers and your card state are automatically restored."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "・开启 Wi-Fi 和蓝牙即可无需繁琐配对自动连接附近的主持人。\n・即使中途加入或重启应用，已开出的号码和卡片状态也会自动恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "・開啟 Wi-Fi 和藍牙即可無需繁瑣配對自動連線附近的主持人。\n・即使中途加入或重新啟動應用程式，已開出的號碼和卡片狀態也會自動恢復。"
          }
        }
      }
    },

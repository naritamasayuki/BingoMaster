    "インターネット不要！近くの端末と自動につながるビンゴアプリ": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネット不要！近くの端末と自動につながるビンゴアプリ"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet needed! Automatically connects with nearby devices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需联网！自动连接附近设备的宾果应用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需聯網！自動連線附近裝置的賓果應用程式"
          }
        }
      }
    },
    "番号を引く・音声読み上げ": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "番号を引く・音声読み上げ"

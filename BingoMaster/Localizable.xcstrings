    "司会者が引いた数字のマスを自動的に開けます（途中参加でもそれまでの番号がすべて自動で開きます）。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "司会者が引いた数字のマスを自動的に開けます（途中参加でもそれまでの番号がすべて自動で開きます）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically marks drawn numbers on your card (even if you join mid-game)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动标记主持人抽出的数字（即使中途加入也会自动补齐之前的号码）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動標記主持人抽出的數字（即使中途加入也會自動補齊先前的號碼）。"
          }
        }
      }
    },
    "出た数字のマスが金色に光ります。自分でタップして穴を開けましょう！（自動に切り替えるとこれまでの番号も一括で開きます）": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出た数字のマスが金色に光ります。自分でタップして穴を開けましょう！（自動に切り替えるとこれまでの番号も一括で開きます）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drawn numbers glow gold—tap them to punch! (Switching to Auto marks all prior drawn numbers at once.)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开出的数字会发出金光，点击即可标记！（切换为自动模式可一键标记此前所有号码）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已開出的數字會發出金光，點擊即可標記！（切換為自動模式可一鍵標記此前所有號碼）"
          }
        }
      }
    },

    "不正防止ロック中＆自動保存中：アプリを閉じてもカードや穴あけ状態は自動で保存・復元されます（司会者がリセットした時のみ新規配布）": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不正防止ロック中＆自動保存中：アプリを閉じてもカードや穴あけ状態は自動で保存・復元されます（司会者がリセットした時のみ新規配布）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anti-Cheat & Auto-Save: Your card and marks persist even if you close the app (new card only on host reset)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防作弊锁定＆自动保存中：即使关闭应用，卡片和标记状态也会自动保存与恢复（仅主持人重置时发新卡）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防作弊鎖定＆自動儲存中：即使關閉應用程式，卡片和標記狀態也會自動儲存與恢復（僅主持人重置時發新卡）"
          }
        }
      }
    },

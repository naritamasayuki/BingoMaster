            "value": "作为主持人开始"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "作為主持人開始"
          }
        }
      }
    },
    "ルーレットで1〜75の番号を抽選し、音声ボイスで読み上げながら周囲の参加者へ出目を自動配信します。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーレットで1〜75の番号を抽選し、音声ボイスで読み上げながら周囲の参加者へ出目を自動配信します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw numbers 1–75 on the roulette, announce them by voice, and automatically sync results to nearby players."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用转盘抽取1〜75号球，通过语音播报并自动向周围参与者同步开奖号码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用轉盤抽取1〜75號球，透過語音播報並自動向周圍參與者同步開獎號碼。"
          }
        }
      }
    },
    "5×5デジタルカードで遊ぶ": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5×5デジタルカードで遊ぶ"
          }

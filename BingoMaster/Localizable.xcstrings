    "参加者の iPhone でこの QR コードを読み取ると、App Store から「ビンゴマスター」をすぐダウンロードできます。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加者の iPhone でこの QR コードを読み取ると、App Store から「ビンゴマスター」をすぐダウンロードできます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have players scan this QR code with their iPhone camera to download Bingo Master from the App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请参与者使用 iPhone 相机扫描此二维码，即可从 App Store 立即下载「宾果大师」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請參與者使用 iPhone 相機掃描此 QR Code，即可從 App Store 立即下載「賓果大師」。"
          }
        }
      }
    },
    "ビンゴ大会に参加しよう！こちらからアプリをダウンロードしてください。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビンゴ大会に参加しよう！こちらからアプリをダウンロードしてください。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join our Bingo game! Download Bingo Master from the App Store here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快来参加宾果游戏吧！点击这里下载「宾果大师」应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快來參加賓果遊戲吧！點擊這裡下載「賓果大師」應用程式。"
          }
        }
      }
    },

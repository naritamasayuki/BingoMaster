    "ゲーム開始後（1球目抽選後）は、他人へのなりすまし防止のためニックネームを変更できません。司会者がゲームをリセットした後に変更できます。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム開始後（1球目抽選後）は、他人へのなりすまし防止のためニックネームを変更できません。司会者がゲームをリセットした後に変更できます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To prevent impersonation, you cannot change your nickname after the first number is drawn. You can change it after the host resets the game."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏开始（抽出第1个号码）后，为防止冒充他人，无法更改昵称。主持人重置游戏后即可更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲開始（抽出第1個號碼）後，為防止冒充他人，無法更改暱稱。主持人重置遊戲後即可更改。"
          }
        }
      }
    },
    "参加者モード": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加者モード"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Player Mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参与者模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "參與者模式"
          }
        }
      }
    },
    "ゲーム進行中（抽選開始後）は、なりすまし司会者や不正なカードリセットを防ぐためモードを切り替えられません。司会者がゲームをリセットした後に切り替えられます。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム進行中（抽選開始後）は、なりすまし司会者や不正なカードリセットを防ぐためモードを切り替えられません。司会者がゲームをリセットした後に切り替えられます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To prevent card resets or spoofing while a game is in progress, mode switching is locked until the host resets the game."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏进行中（抽号开始后），为防止冒充或恶意重置卡片，无法切换模式。主持人重置游戏后即可切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲進行中（抽號開始後），為防止冒充或惡意重置卡片，無法切換模式。主持人重置遊戲後即可切換。"
          }
        }
      }
    },
    "ゲーム開始後（1球目抽選後）は、他の参加者へのなりすまし防止のためニックネームを変更できません。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム開始後（1球目抽選後）は、他の参加者へのなりすまし防止のためニックネームを変更できません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot change your nickname after the first number is drawn to prevent impersonation."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏开始（抽出第1个号码）后，为防止冒充其他参与者，无法更改昵称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "遊戲開始（抽出第1個號碼）後，為防止冒充其他參與者，無法更改暱稱。"

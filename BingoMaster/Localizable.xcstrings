          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抽取號碼・語音播報"
          }
        }
      }
    },
    "司会者（ホスト）ではじめる": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "司会者（ホスト）ではじめる"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start as Host"
          }
        },
        "zh-Hans": {
          "stringUnit": {
